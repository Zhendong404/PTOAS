// RUN: pto-test-opt %s -vmi-to-vpto | FileCheck %s

// `gs(N, slots = 1)` hands back one physical part per group with the value in
// lane zero; its dense counterpart is a single carrier with the group values in
// lanes 0..N-1.  That N-part -> 1-part repack is materialized with one
// `vdup(LOWEST)` + `vsel(lane range)` per extra group.

module {
  func.func @vmi_to_vpto_ensure_group_slots1_repack(
      %v: !pto.vmi.vreg<4xui8, #pto.vmi.layout<num_groups = 4, slots = 1>>)
      -> !pto.vreg<256xui8> {
    %ev = "pto.vmi.ensure_layout"(%v)
        : (!pto.vmi.vreg<4xui8, #pto.vmi.layout<num_groups = 4, slots = 1>>)
        -> !pto.vmi.vreg<4xui8, #pto.vmi.layout<contiguous>>
    %p = "pto.vmi.unpack"(%ev)
        : (!pto.vmi.vreg<4xui8, #pto.vmi.layout<contiguous>>) -> !pto.vreg<256xui8>
    return %p : !pto.vreg<256xui8>
  }
}

// CHECK-LABEL: func.func @vmi_to_vpto_ensure_group_slots1_repack(
// CHECK-COUNT-3: pto.vdup
// CHECK-COUNT-3: pto.vsel
// CHECK-NOT: pto.vmi.
