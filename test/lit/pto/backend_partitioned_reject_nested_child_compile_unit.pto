// RUN: not ptoas --pto-arch=a5 %s -o %t.o 2>&1 | FileCheck %s
// Guards the mixed-backend direct-child contract: each backend child must
// directly own its func.func definitions instead of wrapping them in another
// nested builtin.module.

module attributes {pto.target_arch = "a5"} {
  module attributes {pto.backend = "emitc"} {
    module {
      func.func @emitc_entry() attributes {pto.entry} {
        return
      }
    }
  }

  module attributes {pto.backend = "vpto"} {
    func.func @sidecar() {
      return
    }
  }
}

// CHECK: error: mixed-backend child compile units must directly own their func.func definitions; nested wrapper modules inside a child are not supported
