// Guards the supported nested-wrapper single-backend shape: the driver peels
// the wrapper before entering the single-backend EmitC pipeline.
// RUN: ptoas --pto-backend=emitc --pto-arch=a5 --emit-pto-ir %s -o - | FileCheck %s --check-prefix=EMITC

module attributes {pto.target_arch = "a5"} {
  module attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    func.func @kernel(%gm_slot_buffer : !pto.ptr<f32>, %src : !pto.ptr<f32>)
        attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
      %c0 = arith.constant 0 : index
      %c1 = arith.constant 1 : index
      %c16 = arith.constant 16 : index
      %gm_slots = pto.make_tensor_view %gm_slot_buffer,
        shape = [%c16, %c16], strides = [%c16, %c1]
        : !pto.tensor_view<16x16xf32>
      pto.aiv_initialize_pipe {id = 0, dir_mask = 1, slot_size = 1024}
        (gm_slot_tensor = %gm_slots : !pto.tensor_view<16x16xf32>)

      %tv = pto.make_tensor_view %src,
        shape = [%c16, %c16], strides = [%c16, %c1]
        : !pto.tensor_view<16x16xf32>
      %sv = pto.partition_view %tv,
        offsets = [%c0, %c0], sizes = [%c16, %c16]
        : !pto.tensor_view<16x16xf32> -> !pto.partition_tensor_view<16x16xf32>
      %dst = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
      pto.tload ins(%sv : !pto.partition_tensor_view<16x16xf32>)
                outs(%dst : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      func.return
    }
  }
}

// EMITC-LABEL: func.func @kernel
// EMITC: pto.initialize_l2g2l_pipe
// EMITC-NOT: pto.aiv_initialize_pipe
