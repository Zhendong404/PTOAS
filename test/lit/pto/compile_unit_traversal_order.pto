// Guards compile-unit traversal for the backend-partitioned container shape:
// one outer module containing 1..N child modules, with direct funcs in child
// body source order.
// RUN: ptoas --pto-backend=emitc --pto-arch=a5 --pto-print-compile-unit-order %s -o /dev/null | FileCheck %s

module attributes {pto.target_arch = "a5"} {
  module {
    func.func @child_a_entry() {
      return
    }

    func.func private @child_a_helper() {
      return
    }
  }

  module {
    func.func @child_b_entry() {
      return
    }
  }
}

// CHECK: compile-unit[0]: child_a_entry child_a_helper child_b_entry
