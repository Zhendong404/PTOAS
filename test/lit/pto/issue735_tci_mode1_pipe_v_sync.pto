// RUN: ptoas --pto-arch=a5 --pto-level=level3 --enable-insert-sync --emit-pto-ir --pto-insert-sync-debug=2 %s -o - 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a5"} {
  func.func @tci_mode1_to_store(%dst_view: !pto.partition_tensor_view<1x128xi32>) {
    %start = arith.constant 0 : i32
    %tmp_addr = arith.constant 131072 : i64
    %dst_addr = arith.constant 0 : i64
    %tmp = pto.alloc_tile addr = %tmp_addr : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=512, v_row=1, v_col=512, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile addr = %dst_addr : !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=128, v_row=1, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.tci ins(%start, %tmp : i32, !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=512, v_row=1, v_col=512, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      outs(%dst : !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=128, v_row=1, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      {descending = true}
    pto.tstore ins(%dst : !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=128, v_row=1, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      outs(%dst_view : !pto.partition_tensor_view<1x128xi32>)
    return
  }
}

// CHECK: COMPOUND pto.tci [PIPE_V]
// CHECK: POST: set_flag <PIPE_V -> PIPE_MTE3>
// CHECK: COMPOUND pto.tstore [PIPE_MTE3]
// CHECK: PRE : wait_flag <PIPE_V -> PIPE_MTE3>
