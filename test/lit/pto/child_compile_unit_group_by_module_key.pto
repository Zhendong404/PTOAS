// Guard: same-backend child modules must be split into separate child compile
// units when their visible module-level compile keys differ.
// RUN: env PTOAS_DEBUG_CHILD_UNIT=1 ptoas --pto-arch=a5 %s -o %t.o > %t.log 2>&1 || true
// RUN: FileCheck %s --check-prefix=COUNT < %t.log
// RUN: FileCheck %s --check-prefix=VECTOR < %t.log
// RUN: FileCheck %s --check-prefix=CUBE < %t.log

module attributes {pto.target_arch = "a5"} {
  module attributes {pto.backend = "emitc", pto.kernel_kind = #pto.kernel_kind<vector>} {
    func.func @vector_entry() attributes {pto.entry, pto.kernel_kind = #pto.kernel_kind<vector>} {
      return
    }
  }

  module attributes {pto.backend = "emitc", pto.kernel_kind = #pto.kernel_kind<cube>} {
    func.func @cube_entry() attributes {pto.entry, pto.kernel_kind = #pto.kernel_kind<cube>} {
      return
    }
  }
}

// COUNT-COUNT-2: // ----- child compile unit ----- //
// VECTOR: module attributes {pto.kernel_kind = #pto.kernel_kind<vector>, pto.target_arch = "a5"} {
// VECTOR: func.func @vector_entry()
// CUBE: module attributes {pto.kernel_kind = #pto.kernel_kind<cube>, pto.target_arch = "a5"} {
// CUBE: func.func @cube_entry()
