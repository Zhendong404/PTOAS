// A partitioned MAT load may read a narrower logical tile from a wider
// row-strided GM view. The selected template must preserve the physical row
// stride when it renders the ND2NZ movement.
//
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --tile-lib-backend=ptodsl %s -o - 2>/dev/null | FileCheck %s

// CHECK-LABEL: func.func @TLOAD_STRIDED_PARTITION
// CHECK: pto.copy_gm_to_cbuf_multi_nd2nz
// CHECK-SAME: %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}

module attributes {pto.kernel_kind = #pto.kernel_kind<cube>} {
  func.func @TLOAD_STRIDED_PARTITION(%src: !pto.ptr<f16, gm>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c16 = arith.constant 16 : index
    %c32 = arith.constant 32 : index
    %view = pto.make_tensor_view %src,
      shape = [%c1, %c1, %c1, %c16, %c32],
      strides = [%c32, %c32, %c32, %c32, %c1]
      : !pto.tensor_view<1x1x1x16x32xf16>
    %part = pto.partition_view %view,
      offsets = [%c0, %c0, %c0, %c0, %c0],
      sizes = [%c1, %c1, %c1, %c16, %c16]
      : !pto.tensor_view<1x1x1x16x32xf16> -> !pto.partition_tensor_view<1x1x1x16x16xf16>
    %dst = pto.alloc_tile
      : !pto.tile_buf<loc=mat, dtype=f16, rows=16, cols=16, v_row=16, v_col=16,
                      blayout=col_major, slayout=row_major, fractal=512, pad=0>
    pto.tload ins(%part : !pto.partition_tensor_view<1x1x1x16x16xf16>)
               outs(%dst : !pto.tile_buf<loc=mat, dtype=f16, rows=16, cols=16,
                                         v_row=16, v_col=16, blayout=col_major,
                                         slayout=row_major, fractal=512, pad=0>)
    return
  }
}
