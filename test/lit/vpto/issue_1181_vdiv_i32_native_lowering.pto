// Regression test for issue 1181: A5 integer pto.vdiv must lower to the native
// VDIV intrinsic.  Exercise both signed and unsigned 32-bit forms.  This
// intentionally exercises pto.vdiv (the VPTO vector op), not pto.ub.vdiv.
// The latter is an A2/A3 UB op and is covered by the UB lowering tests.
//
// RUN: ptoas --cann-output-version=9.0.0 --pto-arch=a5 --pto-backend=vpto --emit-vpto-llvm-ir %s -o - 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @issue_1181_vdiv_i32(%lhs: !pto.vreg<64xsi32>,
                                  %rhs: !pto.vreg<64xsi32>,
                                  %dst: !pto.ptr<si32, ub>,
                                  %mask: !pto.mask<b32>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %quotient = pto.vdiv %lhs, %rhs, %mask :
      !pto.vreg<64xsi32>, !pto.vreg<64xsi32>, !pto.mask<b32> -> !pto.vreg<64xsi32>
    pto.vsts %quotient, %dst[%c0], %mask :
      !pto.vreg<64xsi32>, !pto.ptr<si32, ub>, !pto.mask<b32>
    return
  }

  func.func @issue_1181_vdiv_u32(%lhs: !pto.vreg<64xui32>,
                                  %rhs: !pto.vreg<64xui32>,
                                  %dst: !pto.ptr<ui32, ub>,
                                  %mask: !pto.mask<b32>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %quotient = pto.vdiv %lhs, %rhs, %mask :
      !pto.vreg<64xui32>, !pto.vreg<64xui32>, !pto.mask<b32> -> !pto.vreg<64xui32>
    pto.vsts %quotient, %dst[%c0], %mask :
      !pto.vreg<64xui32>, !pto.ptr<ui32, ub>, !pto.mask<b32>
    return
  }
}

// CHECK-LABEL: define void @issue_1181_vdiv_i32_mix_aiv
// CHECK: call <64 x i32> @llvm.hivm.vdiv.s.x.v64i32
// CHECK-LABEL: define void @issue_1181_vdiv_u32_mix_aiv
// CHECK: call <64 x i32> @llvm.hivm.vdiv.u.x.v64i32
