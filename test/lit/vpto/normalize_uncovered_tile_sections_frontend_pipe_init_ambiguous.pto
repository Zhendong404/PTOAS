// Guard: uncovered frontend pipe init ops that land in the same top-level
// segment must still fail strict ownership inference when they mix AIC and AIV
// initialization in one logical region.
// RUN: not ptoas --pto-arch=a5 --pto-backend=vpto --emit-pto-ir %s -o - 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a5"} {
  func.func @reject_mixed_frontend_pipe_init_in_one_segment(%consumer_buf: i32)
      attributes {pto.kernel} {
    %true = arith.constant true
    scf.if %true {
      pto.aic_initialize_pipe {id = 0, dir_mask = 1, slot_size = 1024}
        (c2v_consumer_buf = %consumer_buf : i32)
      pto.aiv_initialize_pipe {id = 1, dir_mask = 1, slot_size = 1024}
        (c2v_consumer_buf = %consumer_buf : i32)
    }
    return
  }
}

// CHECK: error: 'func.func' op contains an uncovered top-level TileOp segment whose section kind cannot be inferred uniquely
// CHECK-SAME: saw both vector-like and cube-like TileOps in the same segment
