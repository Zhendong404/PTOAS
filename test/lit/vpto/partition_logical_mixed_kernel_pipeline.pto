// SPLIT: module attributes {pto.backend = "vpto", pto.target_arch = "a5"} {
// SPLIT: module attributes {pto.backend = "vpto", pto.kernel_kind = #pto.kernel_kind<vector>, pto.target_arch = "a5"} {
// SPLIT: func.func @logical_mixed_kernel
// SPLIT: pto.mte_gm_ub
// SPLIT-NOT: pto.copy_ubuf_to_cbuf
// SPLIT: module attributes {pto.backend = "vpto", pto.kernel_kind = #pto.kernel_kind<cube>, pto.target_arch = "a5"} {
// SPLIT: func.func @logical_mixed_kernel
// SPLIT: pto.copy_ubuf_to_cbuf
// SPLIT-NOT: pto.mte_gm_ub

// NORMALIZE: // -----// IR Dump After PTONormalizeKernelKindContainer (pto-normalize-kernel-kind-container) //----- //
